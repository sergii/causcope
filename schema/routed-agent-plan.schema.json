{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/routed-agent-plan.schema.json",
  "title": "Causcope routed agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "incident_id", "evidence_revision", "plan", "routing"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "routed_agent_plan"},
    "incident_id": {"type": "string", "minLength": 1},
    "evidence_revision": {"type": "integer", "minimum": 0},
    "plan": {"type": "object"},
    "routing": {"type": "object"}
  }
}
