{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/testbed-scenario.schema.json",
  "title": "Causcope testbed scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "slug",
    "title",
    "initial_report",
    "activation",
    "working_controls",
    "verification",
    "oracle_file"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "testbed_scenario"},
    "id": {"type": "string", "pattern": "^scenario\\."},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "initial_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "details": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "mode"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "mode": {"enum": ["temporary_fault", "traffic_generator"]},
        "duration_env": {"type": "string", "minLength": 1},
        "default_duration_seconds": {"type": "integer", "minimum": 1},
        "startup_wait_seconds": {"type": "number", "minimum": 0}
      }
    },
    "working_controls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "oracle_file": {"type": "string", "pattern": "^[^/]+\\.json$"}
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "path", "expect_status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/"},
        "json": {},
        "headers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "expect_status": {"type": "integer", "minimum": 100, "maximum": 599}
      }
    }
  }
}
