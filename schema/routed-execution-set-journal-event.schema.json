{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/routed-execution-set-journal-event.schema.json",
  "title": "Causcope routed execution-set journal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "sequence",
    "event_type",
    "recorded_at",
    "incident_id",
    "execution_set_id",
    "evidence_revision",
    "data",
    "previous_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "routed_execution_set_journal_event"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": ["set_started", "member_succeeded", "set_committed"]
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "incident_id": {"type": "string", "minLength": 1},
    "execution_set_id": {
      "type": "string",
      "pattern": "^execution-set\\.[0-9a-f]{16}$"
    },
    "evidence_revision": {"type": "integer", "minimum": 0},
    "data": {"type": "object"},
    "previous_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
