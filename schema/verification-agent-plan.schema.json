{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/verification-agent-plan.schema.json",
  "title": "Causcope verification agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "incident_id", "baseline_evidence_revision", "target", "original_scope", "fix_applied_at", "outcome_before", "criteria", "executable"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "verification_agent_plan"},
    "incident_id": {"type": "string", "minLength": 1},
    "baseline_evidence_revision": {"type": "integer", "minimum": 0},
    "target": {"type": "string", "minLength": 1},
    "original_scope": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "fix_applied_at": {"type": "string", "format": "date-time"},
    "outcome_before": {"enum": ["resolved", "regressed", "inconclusive"]},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "expected_state", "current_status", "action", "candidate_probes", "selected_probe", "routing"],
        "properties": {
          "observation": {"type": "string", "minLength": 1},
          "expected_state": {"const": "absent"},
          "current_status": {"enum": ["resolved", "regressed", "inconclusive"]},
          "action": {"enum": ["already_satisfied", "regression_detected", "execute_direct_probe", "no_canonical_probe", "no_safe_instrument"]},
          "candidate_probes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "selected_probe": {"type": ["string", "null"]},
          "routing": {"type": ["object", "null"]}
        }
      }
    },
    "executable": {"type": "boolean"}
  }
}
