{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/acceptance-benchmark-result.schema.json",
  "title": "Causcope acceptance benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "benchmark_id",
    "surface",
    "scenario_id",
    "incident_id",
    "llm",
    "oracle_policy",
    "expectations",
    "observed",
    "checks",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "acceptance_benchmark_result"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark\\."},
    "surface": {
      "enum": [
        "deterministic_shop_autonomous",
        "deterministic_mcp_agent",
        "openai_mcp_agent"
      ]
    },
    "scenario_id": {"type": "string", "pattern": "^scenario\\."},
    "incident_id": {"type": "string", "minLength": 1},
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "credential_environment_removed"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "credential_environment_removed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "api_key_exposed_to_testbed_children": {"type": "boolean"},
        "response_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["response_count", "input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "response_count": {"type": "integer", "minimum": 0},
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          },
          "then": {
            "required": [
              "provider",
              "model",
              "api_key_exposed_to_testbed_children",
              "response_ids",
              "usage"
            ],
            "properties": {
              "provider": {"const": "openai"},
              "api_key_exposed_to_testbed_children": {"const": false}
            }
          }
        }
      ]
    },
    "oracle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded_after_investigation", "used_to_construct_diagnosis"],
      "properties": {
        "loaded_after_investigation": {"const": true},
        "used_to_construct_diagnosis": {"const": false}
      }
    },
    "expectations": {"type": "object"},
    "observed": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "expected", "actual"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "expected": {},
          "actual": {}
        }
      }
    },
    "passed": {"type": "boolean"}
  }
}
