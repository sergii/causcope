#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

case "${1:-}" in
  scan)
    shift
    exec python3 "$ROOT/scripts/causcope_scan.py" "$@"
    ;;
  rails)
    shift
    exec python3 "$ROOT/scripts/causcope_rails.py" "$@"
    ;;
  runtime)
    shift
    exec python3 "$ROOT/scripts/causcope_runtime.py" "$@"
    ;;
  recommendation)
    shift
    exec python3 "$ROOT/scripts/causcope_recommendation.py" "$@"
    ;;
  why)
    shift
    exec python3 "$ROOT/scripts/causcope_why_entry.py" "$@"
    ;;
esac

exec python3 "$ROOT/scripts/causcope_cli.py" "$@"
