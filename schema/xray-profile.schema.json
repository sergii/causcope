{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/xray-profile.schema.json",
  "title": "Causcope declarative X-Ray profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "catalog_code",
    "hypothesis",
    "inputs",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "xray_profile"},
    "id": {"type": "string", "pattern": "^xray\\.[a-z0-9_.-]+$"},
    "catalog_code": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "pattern": "^hypothesis\\.[a-z0-9_.-]+$"},
    "symptom": {"type": "string", "pattern": "^symptom\\.[a-z0-9_.-]+$"},
    "observation": {"type": "string", "pattern": "^observation\\.[a-z0-9_.-]+$"},
    "max_emitted_bindings": {"type": "integer", "minimum": 1, "maximum": 100},
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/input"}
    },
    "identity_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/identity_group"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "identity_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "refs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+$"}
        }
      }
    },
    "value_expression": {
      "oneOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/value_expression"}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["var"],
          "properties": {"var": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["list"],
          "properties": {
            "list": {
              "type": "array",
              "items": {"$ref": "#/$defs/value_expression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["one_of_vars"],
          "properties": {
            "one_of_vars": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["neq"],
          "properties": {"neq": {"$ref": "#/$defs/value_expression"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["one_of"],
          "properties": {
            "one_of": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/value_expression"}
            }
          }
        }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "where": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/value_expression"}
        },
        "bind": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "left", "right"],
      "properties": {
        "op": {"enum": ["eq", "neq", "lt", "set_eq"]},
        "left": {"$ref": "#/$defs/value_expression"},
        "right": {"$ref": "#/$defs/value_expression"}
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "where": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/value_expression"}
        },
        "exact": {"type": "integer", "minimum": 0},
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0}
      },
      "anyOf": [
        {"required": ["exact"]},
        {"required": ["min"]},
        {"required": ["max"]}
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "clauses": {
          "type": "array",
          "items": {"$ref": "#/$defs/clause"}
        },
        "constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/constraint"}
        },
        "cardinality": {
          "type": "array",
          "items": {"$ref": "#/$defs/cardinality"}
        }
      }
    }
  }
}
