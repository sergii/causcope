{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/acceptance-benchmark-result.schema.json",
  "title": "Causcope deterministic acceptance benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "benchmark_id",
    "surface",
    "scenario_id",
    "incident_id",
    "llm",
    "oracle_policy",
    "expectations",
    "observed",
    "checks",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "acceptance_benchmark_result"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark\\."},
    "surface": {"const": "deterministic_shop_autonomous"},
    "scenario_id": {"type": "string", "pattern": "^scenario\\."},
    "incident_id": {"type": "string", "minLength": 1},
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "credential_environment_removed"],
      "properties": {
        "enabled": {"const": false},
        "credential_environment_removed": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "oracle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded_after_investigation", "used_to_construct_diagnosis"],
      "properties": {
        "loaded_after_investigation": {"const": true},
        "used_to_construct_diagnosis": {"const": false}
      }
    },
    "expectations": {"type": "object"},
    "observed": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "expected", "actual"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "expected": {},
          "actual": {}
        }
      }
    },
    "passed": {"type": "boolean"}
  }
}
