{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/provider-bindings.schema.json",
  "title": "Causcope workspace provider bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "bindings"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "provider_bindings"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pgbot_file_binding"}
    }
  },
  "$defs": {
    "pgbot_file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_instance", "driver", "adapter", "context"],
      "properties": {
        "provider_instance": {"type": "string", "minLength": 1},
        "driver": {"const": "pgbot_file"},
        "adapter": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1}
      }
    }
  }
}
