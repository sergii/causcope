{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/verification-contract.schema.json",
  "title": "Causcope verification contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "incident_id",
    "baseline_evidence_revision",
    "target",
    "original_scope",
    "fix_applied_at",
    "created_at",
    "criteria"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "verification_contract"},
    "incident_id": {"type": "string", "minLength": 1},
    "baseline_evidence_revision": {"type": "integer", "minimum": 0},
    "target": {"type": "string", "minLength": 1},
    "original_scope": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "runtime-evidence.schema.json#/$defs/scope"}
      ]
    },
    "fix_applied_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation", "expected_state"],
        "properties": {
          "observation": {"type": "string", "minLength": 1},
          "expected_state": {"const": "absent"}
        }
      }
    }
  }
}
