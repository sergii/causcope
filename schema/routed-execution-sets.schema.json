{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://causcope.dev/schema/routed-execution-sets.schema.json",
  "title": "Causcope routed execution sets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "incident_id", "evidence_revision", "sets"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "kind": {"const": "routed_execution_sets"},
    "incident_id": {"type": "string", "minLength": 1},
    "evidence_revision": {"type": "integer", "minimum": 0},
    "sets": {"type": "array", "items": {"$ref": "#/$defs/execution_set"}}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "attributes": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "minProperties": 1
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "execution_mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "diagnostic_provider"},
        "execution_mode": {"const": "direct"},
        "provider_type": {"type": "string", "minLength": 1},
        "target_resource": {"type": "string", "minLength": 1},
        "endpoint_resource": {"type": "string", "minLength": 1},
        "runner": {"type": "string", "minLength": 1}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "target_resource", "instrument", "supporting_relationship_ids"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "target_resource": {"type": "string", "minLength": 1},
        "instrument": {"$ref": "#/$defs/instrument"},
        "supporting_relationship_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incidentId", "evidenceRevision", "executionSetId"],
      "properties": {
        "incidentId": {"type": "string", "minLength": 1},
        "evidenceRevision": {"type": "integer", "minimum": 0},
        "executionSetId": {"type": "string", "pattern": "^execution-set\\.[0-9a-f]{16}$"}
      }
    },
    "execution_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "scope", "diagnosis_target", "probe_id", "state", "reason", "members",
        "operation", "arguments", "atomic_evidence_commit", "rerank_policy", "failure_policy"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^execution-set\\.[0-9a-f]{16}$"},
        "scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scope"}]},
        "diagnosis_target": {"type": "string", "minLength": 1},
        "probe_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["ready", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}, "uniqueItems": true},
        "operation": {"type": ["string", "null"]},
        "arguments": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/arguments"}]},
        "atomic_evidence_commit": {"const": true},
        "rerank_policy": {"const": "after_all_members"},
        "failure_policy": {"const": "no_state_commit_on_member_failure"}
      }
    }
  }
}
